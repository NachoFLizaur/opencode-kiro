{
  "name": "opencode-kiro",
  "version": "0.4.0",
  "description": "OpenCode V2 plugin for Kiro ACP runtime settings and terminal credit usage",
  "license": "MIT",
  "author": "Nacho F. Lizaur (https://github.com/NachoFLizaur)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NachoFLizaur/opencode-kiro.git"
  },
  "bugs": {
    "url": "https://github.com/NachoFLizaur/opencode-kiro/issues"
  },
  "homepage": "https://github.com/NachoFLizaur/opencode-kiro#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.js",
    "tui.js"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "dependencies": {
    "kiro-acp-ai-provider": "3.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.12",
    "@opencode/theme": "^2.0.12",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^20.19.42",
    "solid-js": "^1.9.12",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kiro",
    "kiro-cli",
    "acp",
    "agent-client-protocol",
    "amazon-q",
    "aws"
  ]
}
